<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kaamly.app">

    <!-- Permissions: Strict Least-Privilege Policy -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Location: Coarse and Fine only when requested by user for local worker matching -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Application Security Hardening -->
    <!-- 1. allowBackup="false": Prevents adb backup extraction of session tokens and local DB -->
    <!-- 2. usesCleartextTraffic="false": Enforces strict HTTPS/TLS, prevents MITM on HTTP -->
    <!-- 3. networkSecurityConfig: Strict certificate anchors, blocks user-installed untrusted CAs -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="KAAMLY"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main Launcher Activity -->
        <!-- Only this entry point is exported to the system launcher -->
        <activity
            android:name=".MainActivity"
            android:label="KAAMLY"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Secure Deep Link: HTTPS domain verification only -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="kaamly.in" />
            </intent-filter>
        </activity>

        <!-- Provider with exported="false" to prevent unauthorized local file access -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kaamly.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
